# Copy to .env for local dev (or set these directly in your host/Docker env).
# Load with: node --env-file=.env --experimental-sqlite dist/server.js

AgentForge_DB_PATH=./data/AgentForge.db
PORT=3000
AgentForge_BASE_URL=http://localhost:3000
# Generate a real one for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AgentForge_SESSION_SECRET=dev-only-insecure-secret-change-me

